PORT=3080
HOST=0.0.0.0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=quizforge
DB_USER=quizforge_app
DB_PASSWORD=CHANGE_ME
DB_POOL_SIZE=10
# 首次启动创建的统一账号；后续改密以数据库为准
APP_USERNAME=learner
APP_PASSWORD=CHANGE_TO_A_STRONG_PASSWORD
SESSION_HOURS=12
WORKER_POLL_MS=1500
AUTO_SEED_VOCABULARY=1
AI_PROVIDER=openclaw
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
MAX_UPLOAD_MB=20
MAX_SOURCE_CHARS=60000
AI_TIMEOUT_MS=120000
# 仅解析旧版 .doc 时需要；Linux 通常留空，Windows 可填写 soffice.exe 完整路径
LIBREOFFICE_PATH=
# 设为 1 时允许无 AI 密钥启动并使用内置演示出题器（仅测试）
ALLOW_DEMO_AI=0

# 在线中英翻译（三选一）：openclaw、azure 或 google；留空时仍可使用本地中英词库
TRANSLATION_PROVIDER=
TRANSLATION_MAX_CHARS=1200
TRANSLATION_MAX_PER_HOUR=30
OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_TRANSLATION_AGENT=openclaw/quizforge-translator
OPENCLAW_QUESTION_AGENT=openclaw/quizforge-question
# 仅在明确配置了私有网络和访问控制时才允许远程 OpenClaw 地址
ALLOW_REMOTE_OPENCLAW=0
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
GOOGLE_TRANSLATE_API_KEY=
